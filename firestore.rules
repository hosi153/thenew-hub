rules_version = '2';
// 더뉴컨벤션 정보허브 — Firestore 보안 규칙 (Firebase 콘솔 > Firestore > 규칙에 붙여넣어 게시)
//
// 한계(중요): 이 사이트는 로그인 없는 공개 서비스라, 예신예랑이 직접 글을 쓰고 지울 수 있어야 합니다.
// 그래서 "누가 썼는지"까지는 규칙으로 막지 못하고, 아래처럼
//  1) 정해진 컬렉션만 허용  2) 문서 크기·필드 타입 제한  3) 일괄 악용(거대 문서, 엉뚱한 컬렉션) 차단
// 까지만 합니다. 완전한 차단(관리자만 삭제 등)은 Firebase Auth + Cloud Functions가 필요합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function smallDoc() {
      return request.resource.data.keys().size() <= 40;
    }
    function strOrAbsent(k, max) {
      return !(k in request.resource.data) || (request.resource.data[k] is string && request.resource.data[k].size() <= max);
    }

    match /hallSchedule/{id} {
      allow read: if true;
      allow create, update: if smallDoc() && strOrAbsent('code', 80) && strOrAbsent('hall', 40) && strOrAbsent('memo', 2000);
      allow delete: if true;
    }
    match /matchingCodes/{id} {
      allow read: if true;
      allow create, update: if smallDoc() && strOrAbsent('code', 80) && strOrAbsent('memo', 2000);
      allow delete: if true;
    }
    match /prepChecklist/{id} {
      allow read: if true;
      allow create, update: if smallDoc();
      allow delete: if true;
    }
    match /instaShares/{id} {
      allow read: if true;
      allow create, update: if smallDoc();
      allow delete: if true;
    }
    // meta: 더 이상 클라이언트가 쓰지 않음 (패치 시스템 제거)
    match /meta/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
